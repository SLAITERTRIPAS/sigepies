rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções auxiliares
    function isSignedIn() { return request.auth != null; }
    
    // Regra para audit_logs
    match /audit_logs/{logId} {
      allow create, read: if isSignedIn();
      allow update, delete: if false;
    }

    // Regra para usuários
    match /users/{userId} {
      allow read, write: if true;
    }

    // Regra principal para matrix_activities (garante acesso irrestrito para leitura e escrita sem erro de permissões)
    match /matrix_activities/{activityId} {
      allow read, write: if true;
    }

    // Regras para actividades e planos
    match /actividades/{id} {
      allow read, write: if true;
    }
    match /plano_actividades/{id} {
      allow read, write: if true;
    }
    match /tetos_orcamentais/{id} {
      allow read, write: if true;
    }
    match /archive_documents/{id} {
      allow read, write: if true;
    }
    match /colaboradores/{id} {
      allow read, write: if true;
    }
    match /colaboradores_chefia/{id} {
      allow read, write: if true;
    }
    match /colaboradores_formacao/{id} {
      allow read, write: if isSignedIn();
    }
    match /instituicoes/{id} {
      allow read, write: if isSignedIn();
    }
    match /suppliers/{id} {
      allow read, write: if isSignedIn();
    }
    match /messages/{id} {
      allow read, write: if isSignedIn();
    }
    match /processos_individuais/{id} {
      allow read, write: if isSignedIn();
    }
    match /processos/{id} {
      allow read, write: if isSignedIn();
    }
    match /calendar_events/{id} {
      allow read, write: if isSignedIn();
    }
    match /events/{id} {
      allow read, write: if isSignedIn();
    }
    match /expedientes/{id} {
      allow read, write: if isSignedIn();
    }
    match /library_visits/{id} {
      allow read, write: if isSignedIn();
    }
    match /library_books/{id} {
      allow read, write: if isSignedIn();
    }
    match /service_requests/{id} {
      allow read, write: if isSignedIn();
    }
    match /notes/{id} {
      allow read, write: if isSignedIn();
    }
    match /estrutura_adicionais/{id} {
      allow read, write: if true;
    }
    match /direcoes_excluidas/{id} {
      allow read, write: if true;
    }
    match /periodos_planificacao/{id} {
      allow read, write: if isSignedIn();
    }
    match /configuracoes/{id} {
      allow read, write: if isSignedIn();
    }
    match /financial_data/{id} {
      allow read, write: if isSignedIn();
    }
    match /materiais_bens/{id} {
      allow read, write: if isSignedIn();
    }
    match /movimentos_economato/{id} {
      allow read, write: if isSignedIn();
    }
    match /inventarios_patrimoniais/{id} {
      allow read, write: if isSignedIn();
    }
    match /requisicoes_internas/{id} {
      allow read, write: if isSignedIn();
    }
    match /assiduidade/{id} {
      allow read, write: if isSignedIn();
    }
    match /drafts/{id} {
      allow read, write: if isSignedIn();
    }
    match /sector_menu_configs/{id} {
      allow read, write: if true;
    }
    match /direcoes_organicas/{id} {
      allow read, write: if true;
    }
    match /orgaos_custom/{id} {
      allow read, write: if true;
    }
    match /hierarchy_user_links/{id} {
      allow read, write: if true;
    }
    match /estrutura_renames/{id} {
      allow read, write: if true;
    }
    match /produtos_unificados/{id} {
      allow read, write: if true;
    }

    // Default deny para qualquer outro caminho não listado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


